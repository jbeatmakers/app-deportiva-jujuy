# Variables de Entorno - App Deportiva Jujuy
# Copiar este archivo como .env y configurar los valores

# Configuración de Flask
FLASK_ENV=development
FLASK_DEBUG=True

# Puerto de la aplicación
PORT=5000

# Base de datos (opcional)
DATABASE_URL=postgresql://usuario:password@localhost:5432/deportes_jujuy

# Zona horaria
TZ=America/Argentina/Jujuy

# Configuración de API (si se usan servicios externos)
API_KEY=tu_api_key_aqui
